# URL pública del sitio (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://marca.com.ar

# Lista de espera. Completar UNO de los dos proveedores.
# Si ninguno está configurado, el formulario responde OK y registra el mail en el log del servidor (modo desarrollo).

# Klaviyo
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Si es "true", Mailchimp manda mail de confirmación (doble opt-in)
MAILCHIMP_DOUBLE_OPT_IN=false
